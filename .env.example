# Copia este archivo como .env antes de ejecutar "docker compose up".
# Valores SOLO para desarrollo local: cámbialos si la base se usará fuera de tu equipo.

# Contraseña del superusuario de PostgreSQL
POSTGRES_PASSWORD=postgres_dev_123

# Contraseñas de las cuentas de cada microservicio (las crea 00-roles.sql)
DB_USUARIOS_PASSWORD=usuarios_dev_123
DB_PACIENTES_PASSWORD=pacientes_dev_123
DB_CITAS_PASSWORD=citas_dev_123

# Clave HS256 compartida para firmar y validar los JWT (mínimo 32 caracteres).
# Genera una propia, por ejemplo: openssl rand -base64 48
JWT_SECRET=cambia-esta-clave-de-desarrollo-por-una-propia-0123456789

# Duración del token en minutos. Para mostrar la expiración en el video se puede usar 2.
JWT_EXPIRATION_MINUTES=60
